{
  "name": "keja",
  "version": "1.0.0",
  "description": "Fullstack Kenyatta University Student Housing platform with frontend and backend",
  "main": "backend/server.js",
  "scripts": {
    "build": "npm install --prefix backend && npm install && vite build",
    "start": "node backend/server.js",
    "dev": "concurrently -n \"API,CLIENT\" -c \"blue,green\" \"node backend/server.js\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node --watch backend/server.js",
    "build:client": "vite build",
    "server": "node backend/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.64.0",
    "react-router-dom": "^7.18.5"
  },
  "keywords": [
    "student-housing",
    "kenyatta-university",
    "keja",
    "express",
    "fullstack"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}
